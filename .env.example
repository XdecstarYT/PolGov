# Statecraft — client environment.
#
# BOTH VALUES ARE OPTIONAL. With neither set, the game runs entirely in the
# browser and saves to localStorage. Set them to enable accounts, cloud saves,
# server-authoritative turn resolution and the AI narrator.
#
# Only ever put PUBLISHABLE values here. Anything prefixed VITE_ is compiled
# into the client bundle and is readable by anyone who loads the page.
#
# The Groq API key is NOT in this file and must never be. It lives only in
# Supabase's encrypted secret store:
#     supabase secrets set GROQ_API_KEY=...

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Optional, and NOT the recommended path: call Groq directly from the
# browser, with no Supabase project at all. Uncomment only if you have
# accepted that this key becomes PUBLIC — readable by any visitor of the
# deployed site via dev tools or view-source, with no rate limit but a
# client-side one this game's own code enforces on itself (bypassable), and
# no way to revoke access to it without rotating the key. See DEPLOY.md
# section 3b. Prefer the Supabase path above whenever you can.
#
# VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
