# Statecraft — client environment.
#
# BOTH VALUES ARE OPTIONAL. With neither set, the game runs entirely in the
# browser and saves to localStorage. Set them to enable accounts, cloud saves,
# server-authoritative turn resolution and the AI narrator.
#
# Only ever put PUBLISHABLE values here. Anything prefixed VITE_ is compiled
# into the client bundle and is readable by anyone who loads the page.
#
# The Groq API key is NOT in this file and must never be. It lives only in
# Supabase's encrypted secret store:
#     supabase secrets set GROQ_API_KEY=...

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
